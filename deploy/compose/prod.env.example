# Copy to prod.env and fill in. Generate the secrets with:
#   python scripts/generate_production_secrets.py
APP_IMAGE=ghcr.io/you/app:1.0.0
SITE_ADDRESS=app.example.com

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=app.example.com
PUBLIC_URL=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
FIELD_ENCRYPTION_ACTIVE_KEY_ID=v1
FIELD_ENCRYPTION_KEYS=
PRIVACY_HMAC_KEY=
AUDIT_HMAC_KEY=

DB_ENGINE=postgresql
DB_NAME=app
# Owner of the schema: used by `migrate` and Temporal only.
DB_USER=app
DB_PASSWORD=
# The role the application runs as. It reads and writes rows and owns nothing, so it cannot
# rewrite the audit trail. Created once, when the database volume is first initialised.
APP_DB_USER=app_runtime
APP_DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
# The database is on the compose network; use TLS to anything outside it.
DB_ALLOW_INSECURE_TRANSPORT=true

REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_ALLOW_INSECURE=true

# Caddy is the only thing in front of the app: trust its network.
TRUSTED_PROXY_IPS=172.16.0.0/12,10.0.0.0/8

# Uploads and privacy exports. Required unless OBJECT_STORAGE_REQUIRED=false with a persistent
# volume mounted at /app/media. Credentials: the standard AWS_* variables or the platform identity.
S3_BUCKET=
# S3_ENDPOINT_URL=      # MinIO, R2, B2
# S3_REGION=
OBJECT_STORAGE_REQUIRED=true

# Error reporting: give a DSN, or turn it off on purpose.
SENTRY_ENABLED=false
# SENTRY_DSN=

# Outgoing mail (the default backend is SMTP).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@app.example.com

# LGPD: published by the transparency endpoint and used for the 15-day reminders.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_ID=
DPO_NAME=
DPO_EMAIL=

TEMPORAL_ENABLED=false
# TEMPORAL_ADDRESS=temporal:7233
